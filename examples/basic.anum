// Примеры четверичной нотации МТС (.anum)
// Четыре абита: [ → ♂∞, ] → ∞♀, 1 → (♂∞ -> ∞♀), 0 → (∞♀ -> ♂∞)

// Пустое ачисло - только ∞

// Одиночные абиты
[
]
1
0

// Простые комбинации
[]
[1]
10
01

// Более сложные последовательности
[10]
[01]
[1]0
0[1]

// Примеры с вложенными контекстами
[[
]]
[[]]
[[1]]

// Длинные последовательности
[101010]
[010101]
[[[[]]]]

// Все четыре абита в разных комбинациях
[10]0[1]
0[1]0[1]
[1][0][1][0]
