// МТС — Четверичные ачисла (Quaternary Anumbers)
// Пример файла .anum (Abits notation)
// Алфавит: 0, 1, [, ]

// ========================================
// Базовые определения абитов
// ========================================
// [ = ♂∞  (начальный смысл)
// ] = ∞♀  (конечный смысл)
// 1 = ♂∞ -> ∞♀  (истина/наличие связи)
// 0 = ∞♀ -> ♂∞  (ложь/отсутствие связи)

// ========================================
// Примеры четверичных ачисел
// ========================================

// Простая истина
1

// Простая ложь
0

// Минимальный замкнутый контекст
// [] резолвируется в ∞ (акорень)
[]

// Последовательность 0 и 1
0101

// Вложенный контекст
[01]

// Глубокая вложенность
[[]]

// Сложный пример из спецификации
01010001[010100[1001]010]

// Число в двоичном представлении
// (каждый бит как абит)
01000001

// Симметричная структура
[0[1]0]

// Чередование
10101010
